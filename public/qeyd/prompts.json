   "id": "c001",
   "group": "Cümlələr: sosial xidmət",
   "text": "Mən DOST mərkəzinə getmək istəyirəm.",
   "kind": "sentence",
   "split": "dev"
  },
  {
   "id": "c002",
   "group": "Cümlələr: sosial xidmət",
   "text": "DOST mərkəzi saat neçədə açılır?",
   "kind": "sentence",
   "split": "test"
  },
  {
   "id": "c003",
   "group": "Cümlələr: sosial xidmət",
   "text": "Əlillik arayışı almaq üçün hara müraciət etməliyəm?",
   "kind": "sentence",
   "split": "dev"
  },
  {
   "id": "c004",
   "group": "Cümlələr: sosial xidmət",
   "text": "Mənim şəxsiyyət vəsiqəmin müddəti bitib.",
   "kind": "sentence",
   "split": "test"
  },
  {
   "id": "c005",
   "group": "Cümlələr: sosial xidmət",
   "text": "Yeni şəxsiyyət vəsiqəsi nə vaxt hazır olacaq?",
   "kind": "sentence",
   "split": "dev"
  },
  {
   "id": "c006",
   "group": "Cümlələr: sosial xidmət",
   "text": "Mən ərizə yazmaq istəyirəm, mənə kömək edə bilərsiniz?",
   "kind": "sentence",
   "split": "test"
  },
  {
   "id": "c007",
   "group": "Cümlələr: sosial xidmət",
   "text": "Hansı sənədləri gətirməliyəm?",
   "kind": "sentence",
   "split": "dev"
  },
  {
   "id": "c008",
   "group": "Cümlələr: sosial xidmət",
   "text": "Sənədlərimi evdə unutmuşam.",
   "kind": "sentence",
   "split": "test"
  },
  {
   "id": "c009",
   "group": "Cümlələr: sosial xidmət",
   "text": "Mənim pensiyam bu ay gəlməyib.",
   "kind": "sentence",
   "split": "dev"
  },
  {
   "id": "c010",
   "group": "Cümlələr: sosial xidmət",
   "text": "Pensiya kartımı itirmişəm.",
   "kind": "sentence",
   "split": "test"
  },
  {
   "id": "c011",
   "group": "Cümlələr: sosial xidmət",
   "text": "Müavinət almaq üçün nə etməliyəm?",
   "kind": "sentence",
   "split": "dev"
  },
  {
   "id": "c012",
   "group": "Cümlələr: sosial xidmət",
   "text": "Növbəm neçənci nömrədir?",
   "kind": "sentence",
   "split": "test"
  },
  {
   "id": "c013",
   "group": "Cümlələr: sosial xidmət",
   "text": "Bir saatdır burada gözləyirəm.",
   "kind": "sentence",
   "split": "dev"
  },
  {
   "id": "c014",
   "group": "Cümlələr: sosial xidmət",
   "text": "Burada işarə dili tərcüməçisi var?",
   "kind": "sentence",
   "split": "test"
  },
  {
   "id": "c015",
   "group": "Cümlələr: sosial xidmət",
   "text": "Mən eşitmirəm, zəhmət olmasa yazın.",
   "kind": "sentence",
   "split": "dev"
  },
  {
   "id": "c016",
   "group": "Cümlələr: sosial xidmət",
   "text": "Zəhmət olmasa yavaş danışın.",
   "kind": "sentence",
   "split": "test"
  },
  {
   "id": "c017",
   "group": "Cümlələr: sosial xidmət",
   "text": "Mən sizi başa düşmədim, bir də deyin.",
   "kind": "sentence",
   "split": "dev"
  },
  {
   "id": "c018",
   "group": "Cümlələr: sosial xidmət",
   "text": "ASAN xidmətdə növbəni internetdən götürmək olar?",
   "kind": "sentence",
   "split": "test"
  },
  {
   "id": "c019",
   "group": "Cümlələr: sosial xidmət",
   "text": "Ünvanımı dəyişmək istəyirəm.",
   "kind": "sentence",
   "split": "dev"
  },
  {
   "id": "c020",
   "group": "Cümlələr: sosial xidmət",
   "text": "Mənim qardaşım da əlillik təqaüdü alır.",
   "kind": "sentence",
   "split": "test"
  },
  {
   "id": "c021",
   "group": "Cümlələr: sosial xidmət",
   "text": "Arayış üç gün sonra hazır olacaq.",
   "kind": "sentence",
   "split": "dev"
  },
  {
   "id": "c022",
   "group": "Cümlələr: sosial xidmət",
   "text": "Bu sənədi notariusda təsdiq etdirməlisiniz.",
   "kind": "sentence",
   "split": "test"
  },
  {
   "id": "c023",
   "group": "Cümlələr: sosial xidmət",
   "text": "Əlillik müddətim bu ay bitir.",
   "kind": "sentence",
   "split": "dev"
  },
  {
   "id": "c024",
   "group": "Cümlələr: sosial xidmət",
   "text": "Komissiyaya nə vaxt gəlməliyəm?",
   "kind": "sentence",
   "split": "test"
  },
  {
   "id": "c025",
   "group": "Cümlələr: sosial xidmət",
   "text": "Mən işsizəm və iş axtarıram.",
   "kind": "sentence",
   "split": "dev"
  },
  {
   "id": "c026",
   "group": "Cümlələr: sosial xidmət",
   "text": "Mənə uyğun iş tapmağa kömək edin.",
   "kind": "sentence",
   "split": "test"
  },
  {
   "id": "c027",
   "group": "Cümlələr: sosial xidmət",
   "text": "Kommunal xərclər üçün güzəşt var?",
   "kind": "sentence",
   "split": "dev"
  },
  {
   "id": "c028",
   "group": "Cümlələr: sosial xidmət",
   "text": "Ailə tərkibi haqqında arayış lazımdır.",
   "kind": "sentence",
   "split": "test"
  },
  {
   "id": "c029",
   "group": "Cümlələr: sosial xidmət",
   "text": "Bu formanı doldurmağa kömək edərsiniz?",
   "kind": "sentence",
   "split": "dev"
  },
  {
   "id": "c030",
   "group": "Cümlələr: sosial xidmət",
   "text": "Mənim telefon nömrəmi yazın.",
   "kind": "sentence",
   "split": "test"
  },
  {
   "id": "c031",
   "group": "Cümlələr: sosial xidmət",
   "text": "Cavabı mənə mesajla göndərin.",
   "kind": "sentence",
   "split": "dev"
  },
  {
   "id": "c032",
   "group": "Cümlələr: sosial xidmət",
   "text": "Video zənglə danışmaq olar?",
   "kind": "sentence",
   "split": "test"
  },
  {
   "id": "c033",
   "group": "Cümlələr: sosial xidmət",
   "text": "Mən sabah yenidən gələcəm.",
   "kind": "sentence",
   "split": "dev"
  },
  {
   "id": "c034",
   "group": "Cümlələr: sosial xidmət",
   "text": "Bu gün qəbul yoxdur.",
