   "split": "test"
  },
  {
   "id": "c035",
   "group": "Cümlələr: sosial xidmət",
   "text": "Müdirlə görüşmək istəyirəm.",
   "kind": "sentence",
   "split": "dev"
  },
  {
   "id": "c036",
   "group": "Cümlələr: sosial xidmət",
   "text": "Şikayətimi kimə yaza bilərəm?",
   "kind": "sentence",
   "split": "test"
  },
  {
   "id": "c037",
   "group": "Cümlələr: sosial xidmət",
   "text": "Ərizəmə hələ cavab verilməyib.",
   "kind": "sentence",
   "split": "dev"
  },
  {
   "id": "c038",
   "group": "Cümlələr: sosial xidmət",
   "text": "Mənim adım Nərmindir.",
   "kind": "sentence",
   "split": "test"
  },
  {
   "id": "c039",
   "group": "Cümlələr: sosial xidmət",
