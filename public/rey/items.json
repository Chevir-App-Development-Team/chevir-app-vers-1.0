 "items": [
  {
   "id": "t01",
   "dir": "t2s",
   "source": "müsahibə M4",
   "text": "Mən kitabı oxumadım.",
   "checks": "inkar: fel + YOX (sual 9)"
  },
  {
   "id": "t02",
   "dir": "t2s",
   "source": "müsahibə M4",
   "text": "O bu gün işə gəlmir.",
   "checks": "inkar, indiki zaman"
  },
  {
   "id": "t03",
   "dir": "t2s",
   "source": "müsahibə M4",
   "text": "Mən sabah gələ bilmərəm.",
   "checks": "felin öz inkar işarəsi"
  },
  {
   "id": "t04",
   "dir": "t2s",
   "source": "müsahibə M4",
   "text": "Sən haradasan?",
   "checks": "sual: üz ifadəsi hələ yoxdur (sual 10)"
  },
  {
   "id": "t05",
   "dir": "t2s",
   "source": "müsahibə M4",
   "text": "Sən evdəsən?",
   "checks": "hə/yox sualı yalnız üzlə? (sual 11)"
  },
  {
   "id": "t06",
   "dir": "t2s",
   "source": "müsahibə M4",
   "text": "Mənim anam eşitmir.",
   "checks": "yiyəlik (sual 14)"
  },
  {
   "id": "t07",
   "dir": "t2s",
   "source": "müsahibə M4",
   "text": "Mən sabah Bakıya gedəcəyəm.",
   "checks": "zaman yalnız SABAH ilə (sual 18)"
  },
  {
   "id": "t08",
   "dir": "t2s",
   "source": "müsahibə M4",
   "text": "Anamla bazara getdim.",
   "checks": "*ilə* atılır (sual 23)"
  },
  {
   "id": "t09",
   "dir": "t2s",
   "source": "müsahibə M4",
   "text": "Mənim adım Leyladır.",
   "checks": "ad şəkilçi ilə yığılır (sual 26, 27)"
  },
  {
   "id": "t10",
   "dir": "t2s",
   "source": "müsahibə M4",
   "text": "Mənim 25 yaşım var.",
   "checks": "lüğətdə 25 yoxdur: rəqəmlərin işarələri (sual 28)"
  },
  {
   "id": "t11",
   "dir": "t2s",
   "source": "müsahibə M4",
   "text": "Sənədləri ASAN-a apardım.",
   "checks": "qısaltma yığılır (sual 26)"
  },
  {
   "id": "t12",
   "dir": "t2s",
   "source": "müsahibə M4",
   "text": "Mən sənə kömək edə bilərəm.",
   "checks": "istiqamət (sual 17), bacarıq (sual 20)"
  },
  {
   "id": "t13",
   "dir": "t2s",
   "source": "müsahibə M4",
   "text": "Sizin eşitmə məhdudiyyətiniz var?",
   "checks": "ifadənin başqa forması işarəyə çatmır (M3)"
  },
  {
   "id": "t14",
   "dir": "t2s",
   "source": "AzSLD test 2",
   "text": "Mən Bakıda yaşayıram"
  },
  {
   "id": "t15",
   "dir": "t2s",
   "source": "AzSLD test 5",
   "text": "Bu mənim atamdır"
  },
  {
   "id": "t16",
   "dir": "t2s",
   "source": "AzSLD test 11",
   "text": "Mən indi ADA universitetindəyəm"
  },
  {
   "id": "t17",
   "dir": "t2s",
   "source": "AzSLD test 19",
   "text": "Mən harda gözləyə bilərəm?"
  },
  {
   "id": "t18",
   "dir": "t2s",
   "source": "AzSLD test 39",
   "text": "Sabah gələ bilərəmmi?"
  },
  {
   "id": "t19",
   "dir": "t2s",
   "source": "AzSLD test 80",
   "text": "Mən xəbərlərə baxmaq istəyirəm"
  },
  {
   "id": "t20",
   "dir": "t2s",
   "source": "AzSLD test 121",
   "text": "Mən dünən dostlarımla görüşmüşdüm"
  },
  {
   "id": "t21",
   "dir": "t2s",
   "source": "AzSLD test 138",
   "text": "Mən bunu 15 manata almışam"
  },
  {
   "id": "t22",
   "dir": "t2s",
   "source": "AzSLD test 185",
   "text": "Eşitmə aparatımın nasazlığı var"
  },
  {
   "id": "t23",
   "dir": "t2s",
   "source": "AzSLD test 228",
   "text": "Mən yeni bank kartı götürmək istəyirəm"
  },
  {
   "id": "t24",
   "dir": "t2s",
   "source": "AzSLD test 232",
   "text": "Mən telefonu təmir etdirmək istəyirəm"
  },
  {
   "id": "t25",
   "dir": "t2s",
   "source": "AzSLD test 258",
   "text": "Mən istəyirəm ki, ünvanlı dövlət sosial yardımı (ÜDSY) alım"
  },
  {
   "id": "t26",
   "dir": "t2s",
   "source": "AzSLD test 261",
   "text": "Mən poliklinikaya (TSEK-ə) getmişəm"
  },
  {
   "id": "t27",
   "dir": "t2s",
   "source": "AzSLD test 284",
   "text": "Mən çantamı itirmişəm"
  },
  {
   "id": "t28",
   "dir": "t2s",
   "source": "AzSLD test 313",
   "text": "Mən səhərlər tez durmağı sevmirəm"
  },
  {
   "id": "t29",
   "dir": "t2s",
   "source": "AzSLD test 328",
   "text": "İki gün sonra güclü külək olacaq"
  },
  {
   "id": "t30",
   "dir": "t2s",
   "source": "AzSLD test 366",
   "text": "Mən bu gün havaya uyğun geyinməmişəm"
  },
  {
   "id": "t31",
   "dir": "t2s",
   "source": "AzSLD test 382",
   "text": "Mənə bu iş haqqında ətraflı məlumat verin"
  },
  {
   "id": "t32",
   "dir": "t2s",
   "source": "AzSLD test 410",
   "text": "Mən onun yazdıqları ilə razı deyiləm"
  },
  {
   "id": "t33",
   "dir": "t2s",
   "source": "AzSLD test 423",
   "text": "Xahiş edirəm, mənə bu şeiri tərcümə edin"
  },
  {
   "id": "t34",
   "dir": "t2s",
   "source": "set C dev c001 (sosial xidmət)",
   "text": "Mən DOST mərkəzinə getmək istəyirəm."
  },
  {
   "id": "t35",
   "dir": "t2s",
   "source": "set C dev c009 (sosial xidmət)",
   "text": "Mənim pensiyam bu ay gəlməyib."
  },
  {
   "id": "t36",
   "dir": "t2s",
   "source": "set C dev c017 (sosial xidmət)",
   "text": "Mən sizi başa düşmədim, bir də deyin."
  },
  {
   "id": "t37",
   "dir": "t2s",
   "source": "set C dev c027 (sosial xidmət)",
   "text": "Kommunal xərclər üçün güzəşt var?"
  },
  {
   "id": "t38",
   "dir": "t2s",
   "source": "set C dev c035 (sosial xidmət)",
   "text": "Müdirlə görüşmək istəyirəm."
  },
  {
   "id": "t39",
   "dir": "t2s",
   "source": "set C dev c045 (sağlıq)",
   "text": "Uşağım xəstədir, öskürür."
  },
  {
   "id": "t40",
   "dir": "t2s",
   "source": "set C dev c053 (sağlıq)",
   "text": "Qan analizi vermək lazımdır."
  },
  {
   "id": "t41",
   "dir": "t2s",
   "source": "set C dev c063 (sağlıq)",
   "text": "Mən hamiləyəm."
  },
  {
   "id": "t42",
   "dir": "t2s",
   "source": "set C dev c071 (sağlıq)",
   "text": "Mənim tibbi sığortam var."
  },
  {
   "id": "t43",
   "dir": "t2s",
   "source": "set C dev c080 (bank və pul)",
   "text": "Maaşım hələ köçürülməyib."
  },
  {
   "id": "t44",
   "dir": "t2s",
   "source": "set C dev c088 (bank və pul)",
   "text": "Mən yüz dollar dəyişmək istəyirəm."
  },
  {
   "id": "t45",
   "dir": "t2s",
   "source": "set C dev c098 (bank və pul)",
   "text": "Kartla ödəmək olar?"
  },
  {
   "id": "t46",
   "dir": "t2s",
   "source": "set C dev c106 (gündəlik həyat)",
   "text": "Sabahın xeyir, necəsən?"
